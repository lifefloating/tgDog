# ====== 数据库 (Postgres - Supabase / Neon) ======
DATABASE_URL="postgresql://user:password@host:5432/tgdog?sslmode=require"

# ====== 加密密钥 (用于加密 Telegram session / api_hash / R2 secret / AI key) ======
# 生成: openssl rand -base64 48
ENCRYPTION_KEY="change-me-to-a-long-random-string-at-least-32-chars"

# ====== Collector <-> Web 内部调用鉴权 ======
INTERNAL_API_SECRET="change-me-shared-secret"
# Collector 内置登录服务监听地址 (web 通过它发起登录)
COLLECTOR_LOGIN_URL="http://localhost:8787"
COLLECTOR_LOGIN_PORT="8787"

# ====== 网页鉴权 (单用户密码) ======
APP_PASSWORD="asdf1234"
# 用于签名 session cookie
AUTH_SECRET="change-me-another-long-random-string"

# ====== Telegram (api_id / api_hash 从 https://my.telegram.org 获取) ======
# 这两个也可以在 web /settings 里按账号配置；此处为默认/单账号便捷用
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ====== Cloudflare R2 (也可在 /settings 配置，加密存 DB) ======
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# ====== AI (OpenAI 兼容接口) ======
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ====== Collector 节奏 ======
# 消息采集是 Telegram 实时推送（无轮询）。下面两项是后台任务节奏：
COLLECTOR_RELOAD_MS="10000"            # 规则/账号热加载，只查本地 DB，可放心调低
COLLECTOR_AVATAR_BACKFILL_MS="600000"  # 源头像补抓，会调 Telegram API，过低会触发 FLOOD_WAIT
