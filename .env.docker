# 本地 Docker 开发用 env（配合 docker-compose.yml）
# 用法：cp .env.docker .env，再补 Telegram api_id/api_hash 与 AI key

# Postgres（容器内服务名 postgres；host 上跑 web/collector 时用 localhost）
DATABASE_URL="postgresql://tgdog:tgdog@localhost:5432/tgdog"

# 加密密钥
ENCRYPTION_KEY="dev-encryption-key-please-change-32chars"

# Collector <-> Web 内部鉴权
INTERNAL_API_SECRET="dev-internal-secret"
COLLECTOR_LOGIN_URL="http://localhost:8787"
COLLECTOR_LOGIN_PORT="8787"

# 网页鉴权
APP_PASSWORD="asdf1234"
AUTH_SECRET="dev-auth-secret-please-change"

# Telegram（必填，从 my.telegram.org 获取）
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# 本地 R2 用 MinIO 替代（S3 兼容）
# 注意：web/collector 跑在容器里（docker compose 全栈部署）时，
# R2_ENDPOINT 要改成 http://minio:9000（容器内服务名）；host 上跑才用 localhost
R2_ACCOUNT_ID="local"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="tgdog-media"
R2_ENDPOINT="http://localhost:9000"
R2_PUBLIC_URL="http://localhost:9000/tgdog-media"

# AI（OpenAI 兼容）
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ====== Collector 节奏 ======
# 消息采集是 Telegram 实时推送（无轮询）。下面两项是后台任务节奏：
COLLECTOR_RELOAD_MS="10000"            # 规则/账号热加载，只查本地 DB，可放心调低
COLLECTOR_AVATAR_BACKFILL_MS="600000"  # 源头像补抓，会调 Telegram API，过低会触发 FLOOD_WAIT
